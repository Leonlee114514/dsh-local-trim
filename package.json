{
  "name": "dsh-local-trim",
  "version": "0.2.2",
  "description": "One-step local model onboarding plus a light harness for DSH: probes local inference endpoints, registers the provider, then trims tools, prompt sections, and tool schemas for that provider only.",
  "type": "module",
  "main": "lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./package.json": "./package.json"
  },
  "files": [
    "lib/",
    "cordis.patch.yml",
    "README.md",
    "LICENSE"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "keywords": [
    "dsh",
    "dsh-plugin",
    "deepseek-harness",
    "local-llm",
    "llama.cpp",
    "ollama",
    "prompt-engineering",
    "context-window"
  ],
  "license": "MIT",
  "author": "Leonlee114514",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Leonlee114514/dsh-local-trim.git"
  },
  "bugs": {
    "url": "https://github.com/Leonlee114514/dsh-local-trim/issues"
  },
  "homepage": "https://github.com/Leonlee114514/dsh-local-trim#readme",
  "engines": {
    "node": ">=20"
  }
}
