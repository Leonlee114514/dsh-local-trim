{
  "name": "dsh-local-trim",
  "version": "0.3.9",
  "description": "One-step local model onboarding plus a light harness for DSH: probes local inference endpoints, registers the provider, then trims tools, prompt sections, and tool schemas for that provider only. Ships a status-aware control panel (import a local model, smoke-test it, watch trim savings) inside the plugin detail page.",
  "type": "module",
  "main": "lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./client": "./client.js",
    "./package.json": "./package.json"
  },
  "files": [
    "lib/",
    "client.js",
    "cordis.patch.yml",
    "README.md",
    "LICENSE"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-client-ui-plugin-manager"
      ]
    },
    "engines": {
      "dsh": ">=0.1.7-rc.1"
    }
  },
  "keywords": [
    "dsh",
    "dsh-plugin",
    "deepseek-harness",
    "local-llm",
    "llama.cpp",
    "ollama",
    "prompt-engineering",
    "context-window"
  ],
  "license": "MIT",
  "author": "Leonlee114514",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Leonlee114514/dsh-local-trim.git"
  },
  "bugs": {
    "url": "https://github.com/Leonlee114514/dsh-local-trim/issues"
  },
  "homepage": "https://github.com/Leonlee114514/dsh-local-trim#readme",
  "engines": {
    "node": ">=20"
  },
  "devDependencies": {
    "@deepseek-ai/schemastery": "^3.18.5"
  },
  "peerDependencies": {
    "@deepseek-ai/schemastery": "^3.18.5"
  },
  "peerDependenciesMeta": {
    "@deepseek-ai/schemastery": {
      "optional": true
    }
  }
}
